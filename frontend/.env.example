# Base URL of the NestJS API (backend repo). Must be listed in the API's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Set to true when the site and API are on different sites (e.g. two *.up.railway.app
# domains): the browser then calls this site and Next proxies /v1/* to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_PROXY=false
# Public origin of this site, used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on /contact.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Footer social links (optional). Each icon shows only when its URL is set.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
