# Base URL of the NestJS API (backend repo). Browsers never call it directly: they call /v1/*
# on this site, which src/proxy.ts forwards here (keeps the session cookie first-party).
# This site's origin must be listed in the API's CORS_ORIGINS (its CSRF check reads it).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-only secret, same value as the API's PROXY_SECRET. Lets the proxy pass on each
# visitor's IP so the API's per-IP rate limits apply per visitor. Required when deployed;
# leave empty locally. Generate: openssl rand -hex 32. Never prefix it with NEXT_PUBLIC_.
PROXY_SECRET=
# Public origin of this site, used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on /contact.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Footer social links (optional). Each icon shows only when its URL is set.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
