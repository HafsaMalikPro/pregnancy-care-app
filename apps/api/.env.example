NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://preconception:preconception_local@localhost:5434/preconception
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Per-instance DB pool. Keep instances × DATABASE_POOL_MAX below Postgres max_connections.
DATABASE_POOL_MAX=10
# Max wait for a free pool connection before a request fails (ms; 0 waits forever).
DATABASE_POOL_TIMEOUT_MS=5000
# Better Auth. Generate the secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
# Staff routes require 2FA. Set to false only for local development.
ADMIN_REQUIRE_MFA=true
ANONYMOUS_SESSION_TTL_DAYS=180
# Public URL of the website; reset and verification emails link here.
APP_URL=http://localhost:3000
# Outgoing email: none (reset, verification and reminder emails off), log (prints messages,
# including links, to the console; development only) or resend.
EMAIL_PROVIDER=none
# Required for EMAIL_PROVIDER=resend. Keep the API key in your secret store, not in git.
# EMAIL_FROM="Pregnancy Care <hello@your-domain.example>"
# RESEND_API_KEY=
# Send reminder emails from this process (needs an EMAIL_PROVIDER). Poll interval in ms.
REMINDER_DELIVERY_ENABLED=false
REMINDER_POLL_INTERVAL_MS=30000
# Required for `pnpm test:e2e` and `pnpm test:coverage`: a disposable database the tests may
# fill and change. The e2e suite never falls back to DATABASE_URL and refuses non-local hosts
# (set ALLOW_REMOTE_TEST_DATABASE=true only for a dedicated remote test database).
# TEST_DATABASE_URL=postgresql://preconception:preconception_local@localhost:5434/preconception_e2e
