# syntax=docker/dockerfile:1.7
#
# Image for Render (render.yaml at the repository root). Same build as apps/api/Dockerfile,
# but the container applies database migrations before starting the API, because Render's
# free plan has no pre-deploy step. Run as a single instance: with several instances, run
# `prisma migrate deploy` once as a release step instead (see docs/DEPLOYMENT_RECOMMENDATIONS.md).
#
# Build from the backend/ directory:
#   docker build -f apps/api/Dockerfile.render -t pregnancy-care-api-render .

# Node 22.17.1 on Alpine 3.22, pinned by digest (multi-arch index), as in apps/api/Dockerfile.
ARG NODE_IMAGE=node:22.17.1-alpine3.22@sha256:5539840ce9d013fa13e3b9814c9353024be7ac75aca5db6d039504a56c04ea59

FROM ${NODE_IMAGE}
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/api/package.json apps/api/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/utils/package.json packages/utils/
COPY apps/api/prisma apps/api/prisma
COPY apps/api/prisma.config.ts apps/api/
# prisma generate (postinstall) never connects; this placeholder URL exists only for it.
RUN DATABASE_URL=postgresql://build:build@build.invalid:5432/build pnpm install --frozen-lockfile
COPY . .
RUN DATABASE_URL=postgresql://build:build@build.invalid:5432/build pnpm --filter @preconception/api... build

WORKDIR /repo/apps/api
# The official image's `node` user (uid/gid 1000). Code stays root-owned and read-only.
USER 1000:1000
EXPOSE 4000
# Migrate, then replace the shell with the API so it receives SIGTERM directly.
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && exec node dist/main.js"]
