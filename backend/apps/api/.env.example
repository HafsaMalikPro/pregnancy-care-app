# Pregnancy Care API: environment template.
#
# Copy to apps/api/.env (the API, Prisma and the seed scripts all load .env from apps/api).
# See docs/LOCAL_SETUP.md. Never commit .env; only this file is tracked.
#
# Every variable read by the code is listed here; src/config/env-example.spec.ts fails if one
# is missing. Values are validated at boot by src/config/env.ts, and errors name the variable,
# never its value.

# ----------------------------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------------------------

# Optional. One of: development | test | staging | production. Default: development.
# Production refuses unsafe settings at boot (see the notes on each variable below).
NODE_ENV=development
# Optional. HTTP port, positive integer. Default: 4000.
PORT=4000

# ----------------------------------------------------------------------------------------------
# Database (PostgreSQL 17, via @prisma/adapter-pg)
# ----------------------------------------------------------------------------------------------

# Required. postgres:// or postgresql:// URL. The local Docker database from
# infra/docker/docker-compose.yml (`pnpm db:up`) uses the dev-only credentials below.
DATABASE_URL=postgresql://preconception:preconception_local@localhost:5434/preconception
# Optional. Connections per API instance, positive integer. Default: 10.
# Keep instances x DATABASE_POOL_MAX below Postgres max_connections.
DATABASE_POOL_MAX=10
# Optional. Milliseconds a request waits for a free pool connection (0 = forever). Default: 5000.
DATABASE_POOL_TIMEOUT_MS=5000

# Optional. Milliseconds before Postgres cancels a statement (and an idle transaction).
# 100-120000. Default: 10000.
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Optional. Milliseconds a client has to send its whole request (headers within 10 s).
# 1000-120000. Default: 15000.
REQUEST_TIMEOUT_MS=15000

# ----------------------------------------------------------------------------------------------
# Auth (Better Auth)
# ----------------------------------------------------------------------------------------------

# Required, SECRET. Signs sessions and encrypts two-factor secrets. At least 32 characters.
# Generate: openssl rand -base64 48
# Changing it signs everyone out and makes stored 2FA secrets unreadable.
BETTER_AUTH_SECRET=
# Optional. Public base URL of this API (URL). Default: http://localhost:4000.
# Production requires https://.
BETTER_AUTH_URL=http://localhost:4000
# Optional. Inactive guest (anonymous) sessions and their data expire after this many days.
# Positive integer. Default: 180.
ANONYMOUS_SESSION_TTL_DAYS=180

# ----------------------------------------------------------------------------------------------
# Cookies and CORS
# ----------------------------------------------------------------------------------------------

# Optional. Comma-separated exact origins allowed to call the API with credentials
# (scheme://host[:port], no path or trailing slash). Default: empty (no browser origin).
# Production requires at least one, all https://.
CORS_ORIGINS=http://localhost:3000
# Optional. Public base URL of the website (URL). Reset and verification emails link to
# ${APP_URL}/reset-password and ${APP_URL}/verify-email. Default: http://localhost:3000.
# Production requires https://.
APP_URL=http://localhost:3000
# Optional. true | false. Session cookies carry the Secure attribute (https only).
# Unset: true in production and staging, false otherwise. Production refuses false.
# Leave unset for local http development.
# AUTH_COOKIE_SECURE=

# ----------------------------------------------------------------------------------------------
# Email
# ----------------------------------------------------------------------------------------------

# Optional. One of: none | log | resend | memory. Default: none.
#   none   password reset, email verification and reminder emails are off (their routes 404)
#   log    prints messages, including their links, to the console (development only;
#          production refuses it)
#   resend sends through the Resend HTTP API (needs EMAIL_FROM and RESEND_API_KEY)
#   memory keeps messages in memory (NODE_ENV=test only)
EMAIL_PROVIDER=none
# Required when EMAIL_PROVIDER=resend. Sender, e.g. "Pregnancy Care <hello@your-domain.example>".
EMAIL_FROM=
# Required when EMAIL_PROVIDER=resend, SECRET. Create it in the Resend dashboard; keep it in
# your secret store. Leave empty locally.
RESEND_API_KEY=
# Optional. true | false. Runs the reminder scheduler and sender in this process.
# Needs an EMAIL_PROVIDER other than none. Default: false.
REMINDER_DELIVERY_ENABLED=false
# Optional. Reminder poll interval in milliseconds, at least 1000. Default: 30000.
REMINDER_POLL_INTERVAL_MS=30000

# ----------------------------------------------------------------------------------------------
# Retention
# ----------------------------------------------------------------------------------------------

# Optional. How often (ms) expired guest sessions, old reminder deliveries, expired auth
# sessions/tokens, stale lockout counters and old privacy jobs are deleted. 0 turns it off.
# Default: 21600000 (6 hours).
RETENTION_PURGE_INTERVAL_MS=21600000

# ----------------------------------------------------------------------------------------------
# Rate limiting and proxy
# ----------------------------------------------------------------------------------------------

# Optional. true | false. Per-IP rate limits (Nest throttler and Better Auth). Default: true.
# Production refuses false. Locally, false lets the website's Playwright suite run more than
# once an hour (it signs up about 15 users per run).
RATE_LIMIT_ENABLED=true
# Optional. Which proxies may set X-Forwarded-For. Default: false (the socket address is the
# client IP; the header is ignored). A number 1-10: that many trusted hops in front of the API
# (1 behind a single load balancer). Or a comma-separated list of proxy IPs/CIDRs (keywords
# loopback, linklocal, uniquelocal). `true` (trust any hop) is refused at boot.
TRUST_PROXY=false

# ----------------------------------------------------------------------------------------------
# Passwords
# ----------------------------------------------------------------------------------------------

# Optional. One of: bundled | hibp. Default: bundled. Breached-password check on sign-up,
# password change and reset. `bundled` uses the list shipped with the API; `hibp` also queries
# Have I Been Pwned's k-anonymity range API (only 5 hex characters of the SHA-1 leave the
# server; needs outbound HTTPS to api.pwnedpasswords.com).
PASSWORD_BREACH_CHECK=bundled

# ----------------------------------------------------------------------------------------------
# Security / MFA
# ----------------------------------------------------------------------------------------------

# Optional. true | false. Staff (/v1/admin) routes require two-factor auth. Default: true.
# Production refuses false. Set false only for local admin work without an authenticator.
ADMIN_REQUIRE_MFA=true

# ----------------------------------------------------------------------------------------------
# Encryption keys
# ----------------------------------------------------------------------------------------------

# Required in production, SECRET. AES-256-GCM keys for sensitive free text (journal notes and
# questions, checklist notes, appointment notes and questions, birth-preference notes).
# Format: <id>:<base64 of 32 random bytes>, comma-separated. Keep old keys listed while
# rotating. Generate one: printf 'k1:%s' "$(openssl rand -base64 32)"
# Empty outside production: encryption is off and a warning is logged.
FIELD_ENCRYPTION_KEYS=
# Required in production. The key id used for new writes; must be one of the ids above.
FIELD_ENCRYPTION_ACTIVE_KEY=
# Two-factor secrets and backup codes are encrypted by Better Auth with BETTER_AUTH_SECRET.

# ----------------------------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------------------------

# None. Log output is fixed by NODE_ENV; there is no log-level variable.

# ----------------------------------------------------------------------------------------------
# Features
# ----------------------------------------------------------------------------------------------

# Optional. true | false. Premium content locks. Default: false (everything is accessible and
# clients show no paywall). Payments are out of scope.
FEATURE_PREMIUM_LOCKS=false

# ----------------------------------------------------------------------------------------------
# Dev / seed / tests
# ----------------------------------------------------------------------------------------------

# Sample seeds (`pnpm dlx tsx prisma/seed.ts`, `prisma/seed-journey.ts`) read DATABASE_URL
# and refuse to run unless it points at localhost/127.0.0.1 and NODE_ENV is not production.

# Required for `pnpm test:e2e` and `pnpm test:coverage`: a disposable database the tests may
# fill and change. The e2e suite never falls back to DATABASE_URL and refuses non-local hosts.
TEST_DATABASE_URL=postgresql://preconception:preconception_local@localhost:5434/preconception_e2e
# Optional. true only for a dedicated remote test database. Default: unset (local only).
# ALLOW_REMOTE_TEST_DATABASE=
